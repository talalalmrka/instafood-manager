{
  "name": "talalalmrka/instafood-manager",
  "version": "1.0.0",
  "description": "WordPress plugin for importing, exporting, and managing InstaFood categories, products, variations, and images.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.1",
    "illuminate/pagination": "^12.69",
    "illuminate/support": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Ifm\\": "src/"
    },
    "files": [
      "src/Helpers/index.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.4"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
