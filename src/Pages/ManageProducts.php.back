<?php


namespace Ifm\Pages;

use Ifm\Ifm;
use Ifm\Generic\Page;

class ManageProducts extends Page
{
    public static function title(): string
    {
        return __('Products');
    }

    public static function slug(): string
    {
        return IFM_PAGE_SLUG . '-products';
    }

    public static function boot(): void {}

    public static function render(): void
    {
        if (!current_user_can('manage_options')) {
            wp_die('You do not have permission to access this page.');
        }

        $result = get_transient(self::resultKey());

        if ($result !== false) {
            delete_transient(self::resultKey());
        }
        $perPage = 20;

        $currentPage = isset($_GET['paged'])
            ? max(1, absint($_GET['paged']))
            : 1;

        $query = new \WP_Query([
            'post_type' => IFM_ITEM_POST_TYPE,
            'post_status' => 'any',
            'posts_per_page' => $perPage,
            'paged' => $currentPage,
            'orderby' => 'menu_order',
            'order' => 'ASC',
            'no_found_rows' => false,
            'suppress_filters' => true,
        ]);

        $items = $query->posts;
?>

        <div class="wrap">
            <h1><?php echo esc_html(self::title()); ?></h1>
            <div class="page-wrapper">
                <?php self::renderResult($result); ?>
                <div class="table-container">
                    <table class="table table-divide sm">
                        <thead>
                            <?php self::headRow(); ?>
                        </thead>
                        <tbody>
                            <?php if (!$items): ?>
                                <tr>
                                    <td colspan="8" class="text-center"><?php echo esc_html(__('No items found!')); ?></td>
                                </tr>
                            <?php else: ?>
                                <?php foreach ($items as $index => $item): ?>

                                    <?php
                                    $categories = get_the_terms(
                                        $item->ID,
                                        IFM_ITEM_TAXONOMY
                                    );

                                    $meta = get_post_meta(
                                        $item->ID,
                                        IFM_ITEM_META_KEY,
                                        true
                                    );

                                    $variations = is_array($meta)
                                        && !empty($meta['product_variations'])
                                        && is_array($meta['product_variations'])
                                        ? $meta['product_variations']
                                        : [];

                                    $number = (($currentPage - 1) * $perPage) + $index + 1;
                                    $imageUrl = get_image_by_file_name($item->post_name . '.jpg');
                                    ?>
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="selected" value="<?php echo esc_html($item->ID); ?>">
                                        </td>
                                        <td>
                                            <?php echo esc_html($item->ID); ?>
                                        </td>
                                        <td>
                                            <strong>
                                                <?php echo esc_html($item->post_title); ?>
                                            </strong>

                                            <?php if ($item->post_excerpt): ?>
                                                <div class="text-xs text-muted">
                                                    <?php
                                                    echo esc_html(
                                                        wp_trim_words(
                                                            $item->post_excerpt,
                                                            15
                                                        )
                                                    );
                                                    ?>
                                                </div>
                                            <?php endif; ?>
                                        </td>
                                        <td>
                                            <?php if (!is_wp_error($categories) && $categories): ?>

                                                <?php foreach ($categories as $category): ?>
                                                    <span class="badge badge-primary">
                                                        <?php echo esc_html($category->name); ?>
                                                    </span>
                                                <?php endforeach; ?>

                                            <?php else: ?>

                                                <span class="opacity-50">
                                                    Uncategorized
                                                </span>

                                            <?php endif; ?>
                                        </td>

                                        <td>
                                            <?php echo esc_html(count($variations)); ?>
                                        </td>

                                        <td>
                                            <?php echo esc_html($item->post_status); ?>
                                        </td>

                                        <td>
                                            <?php echo esc_html($item->menu_order); ?>
                                        </td>
                                        <td>
                                            <?php if ($imageUrl): ?>
                                                <img
                                                    src="<?php echo esc_url($imageUrl); ?>"
                                                    alt="<?php echo esc_attr($item->post_title); ?>"
                                                    width="60"
                                                    height="60"
                                                    style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px;">
                                            <?php else: ?>
                                                <span class="opacity-50">No image</span>
                                            <?php endif; ?>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </tbody>
                        <tfoot>
                            <?php self::headRow(); ?>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    <?php
    }

    public static function headRow(): void
    {
    ?>
        <tr>
            <th><input type="checkbox" class="select-all" value="1"></th>
            <th>#</th>
            <th>Product</th>
            <th>Category</th>
            <th>Variations</th>
            <th>Status</th>
            <th>Order</th>
            <th>Image</th>
        </tr>
<?php
    }
}
