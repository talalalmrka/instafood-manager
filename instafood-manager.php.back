    public static function boot(): void
    {
        add_action('admin_menu', [self::class, 'admin_menu']);
        add_action('admin_enqueue_scripts', [self::class, 'enqueue_assets']);
        add_action(
            'admin_post_' . self::NONCE_IMPORT,
            [self::class, 'handle_import']
        );

        add_filter(
            'script_loader_tag',
            [self::class, 'inject_module_type'],
            10,
            2
        );
        add_action(
            'admin_post_instafood_fix_images',
            [self::class, 'handle_fix_images']
        );
    }

    public static function enqueue_assets(string $hook): void
    {
        $allowedHooks = [
            'toplevel_page_' . self::PAGE_SLUG,
            self::PAGE_SLUG . '_page_' . self::PAGE_SLUG . '-export',
            self::PAGE_SLUG . '_page_' . self::PAGE_SLUG . '-manage-categories',
            self::PAGE_SLUG . '_page_' . self::PAGE_SLUG . '-manage-products',
            self::PAGE_SLUG . '_page_' . self::PAGE_SLUG . '-fix-images',

        ];

        if (!in_array($hook, $allowedHooks, true)) {
            return;
        }

        if (self::DEV_MODE) {
            wp_enqueue_script(
                "instafood-manager-vite",
                'http://localhost:5173/@vite/client',
                [],
                null,
                false
            );

            wp_enqueue_script(
                'instafood-manager-main',
                'http://localhost:5173/src/js/main.ts',
                ['instafood-manager-vite'],
                null,
                false
            );

            return;
        }

        wp_enqueue_style(
            'instafood-styles',
            plugins_url('dist/css/style.css', __FILE__),
            [],
            '1.0.0'
        );

        wp_enqueue_script(
            'instafood-main',
            plugins_url('dist/js/main.js', __FILE__),
            [],
            '1.0.0',
            true
        );
    }

    public static function inject_module_type(
        string $tag,
        string $handle
    ): string {
        $moduleHandles = [
            'instafood-manager-vite',
            'instafood-manager-main',
        ];

        if (!in_array($handle, $moduleHandles, true)) {
            return $tag;
        }

        if (str_contains($tag, ' type="module"')) {
            return $tag;
        }

        return str_replace(
            '<script ',
            '<script type="module" ',
            $tag
        );
    }
