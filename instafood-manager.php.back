    private static function find_attachment_by_filename(string $filename): int
    {
        $filename = basename($filename);

        $attachments = get_posts([
            'post_type'      => 'attachment',
            'post_status'    => 'inherit',
            'posts_per_page' => 1,
            'fields'         => 'ids',
            'meta_query'     => [
                [
                    'key'     => '_wp_attached_file',
                    'value'   => $filename,
                    'compare' => 'LIKE',
                ],
            ],
        ]);

        return (int) ($attachments[0] ?? 0);
    }

    private static function get_image_by_file_name(string $filename)
    {
        $imageId = self::find_attachment_by_filename($filename);
        $imageUrl = $imageId
            ? wp_get_attachment_image_url($imageId, 'thumbnail')
            : '';
        return $imageUrl;
    }
